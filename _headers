# NOT THE DEPLOYED FILE. wrangler.toml sets pages_build_output_dir = "website",
# so Pages serves website/ as the site root and reads website/_headers. Every
# rule below is written against /website/... paths that therefore never match
# a real request. The live rules are in website/_headers.
#
# Cache static assets
/website/assets/*
  Cache-Control: public, max-age=31536000, immutable

/website/css/*
  Cache-Control: public, max-age=31536000, immutable

/website/js/*
  Cache-Control: public, max-age=31536000, immutable

/website/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/website/favicon-*.png
  Cache-Control: public, max-age=31536000, immutable

/website/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/coffee-shop/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML files should not be cached
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin